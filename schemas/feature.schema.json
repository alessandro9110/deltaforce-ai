{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/alessandro9110/deltaforce-ai/blob/main/schemas/feature.schema.json",
  "title": "DeltaForce feature",
  "description": "YAML frontmatter of a feature file in .deltaforce/backlog/, written by the PM.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "title", "status", "depends_on", "branch", "tasks", "po_decision", "created", "updated"],
  "properties": {
    "id": { "$ref": "#/$defs/feature_id" },
    "title": { "type": "string", "minLength": 1 },
    "status": { "enum": ["todo", "in_progress", "integrating", "in_test", "awaiting_po", "done", "blocked"] },
    "depends_on": { "type": "array", "items": { "$ref": "#/$defs/feature_id" }, "uniqueItems": true },
    "change_of": {
      "description": "Set on a change feature: the feature already done that this one changes",
      "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/feature_id" }]
    },
    "branch": { "type": ["string", "null"] },
    "tasks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "role", "status", "branch"],
        "properties": {
          "id": { "$ref": "#/$defs/task_id" },
          "title": { "type": "string", "minLength": 1 },
          "role": { "$ref": "#/$defs/role" },
          "status": { "enum": ["todo", "in_progress", "ready_for_integration", "integrated", "done", "blocked"] },
          "branch": { "type": ["string", "null"] },
          "report": { "description": "Specialist reports for this task, one dated section per delegation", "type": ["string", "null"] }
        }
      }
    },
    "bugs": {
      "description": "Defects that live in this feature, wherever they were found. Ids are numbered across the whole backlog.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "severity", "status", "found_by", "found_during", "found_in", "evidence", "fix_tasks", "opened", "closed"],
        "properties": {
          "id": { "$ref": "#/$defs/bug_id" },
          "title": { "type": "string", "minLength": 1 },
          "severity": { "enum": ["blocker", "major", "minor"] },
          "status": { "enum": ["open", "fixing", "fixed", "verified", "wont_fix"] },
          "found_by": { "anyOf": [{ "$ref": "#/$defs/role" }, { "const": "po" }] },
          "found_during": { "enum": ["build", "integration", "test", "g2"] },
          "found_in": { "description": "The feature being worked on when the bug was found", "$ref": "#/$defs/feature_id" },
          "evidence": { "type": "string", "minLength": 1 },
          "fix_tasks": { "type": "array", "items": { "$ref": "#/$defs/task_id" }, "uniqueItems": true },
          "opened": { "$ref": "#/$defs/timestamp" },
          "closed": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/timestamp" }] },
          "notes": { "description": "Why it will not be fixed (the PO's decision), or anything else worth keeping", "type": "string" }
        }
      }
    },
    "po_decision": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["decision", "at", "notes"],
          "properties": {
            "decision": { "enum": ["approved", "changes_requested"] },
            "at": { "$ref": "#/$defs/timestamp" },
            "notes": { "type": "string" }
          }
        }
      ]
    },
    "started": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/timestamp" }] },
    "completed": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/timestamp" }] },
    "created": { "$ref": "#/$defs/timestamp" },
    "updated": { "$ref": "#/$defs/timestamp" }
  },
  "$defs": {
    "feature_id": { "type": "string", "pattern": "^F-[0-9]{3,}$" },
    "task_id": { "type": "string", "pattern": "^T-[0-9]{3,}\\.[0-9]+$" },
    "bug_id": { "type": "string", "pattern": "^B-[0-9]{3,}$" },
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?(Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "role": {
      "enum": [
        "pm",
        "solution-architect",
        "business-analyst",
        "data-engineer",
        "data-analyst",
        "data-scientist",
        "ai-engineer",
        "qa-engineer",
        "devops-engineer"
      ]
    }
  }
}
