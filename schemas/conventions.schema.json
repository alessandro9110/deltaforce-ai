{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/alessandro9110/deltaforce-ai/blob/main/schemas/conventions.schema.json",
  "title": "DeltaForce client conventions",
  "description": "Contents of .deltaforce/conventions.yaml. Known sections are validated; new top-level sections are allowed for client-specific rules.",
  "type": "object",
  "required": ["version", "source"],
  "properties": {
    "version": { "const": 1 },
    "source": { "enum": ["defaults", "po", "derived"] },
    "source_reference": { "type": ["string", "null"] },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": { "enum": ["new", "existing"] }
      }
    },
    "bundle": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "root_path": { "type": ["string", "null"] },
        "prod_run_as": { "type": ["string", "null"] },
        "variables": {
          "description": "Existing project: the project's own bundle variables that hold the dev catalog and the schema of each layer",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "catalog": { "type": ["string", "null"] },
            "schemas": { "type": "object", "additionalProperties": { "type": "string", "minLength": 1 } }
          }
        }
      }
    },
    "cicd": {
      "description": "Where the client's CI/CD pipeline templates are; the DevOps Engineer builds the pipeline on them",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "templates": { "enum": ["repository", "project", "provided", "none"] },
        "repository": { "type": ["string", "null"] },
        "ref": { "type": ["string", "null"] },
        "paths": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "notes": { "type": ["string", "null"] }
      }
    },
    "environments": {
      "description": "The client's environments besides the team's dev target, declared by the PO at kickoff: what each is for and what the team may do there. Deploy access beyond dev applies only once the PO confirms it in the installer; narrower access applies at once.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "team"],
        "properties": {
          "name": { "type": "string", "pattern": "^[A-Za-z0-9_-]+$" },
          "purpose": { "type": ["string", "null"] },
          "workspace": { "enum": ["dev", "production", "other"] },
          "production": { "type": "boolean" },
          "bundle_target": { "type": ["string", "null"], "pattern": "^[A-Za-z0-9_-]+$" },
          "catalogs": { "type": "array", "items": { "type": "string", "pattern": "^[A-Za-z0-9_-]+$" } },
          "team": { "enum": ["deploy", "read", "none"] },
          "deployed_by": { "enum": ["team", "cicd"] },
          "data_rules": { "type": "array", "items": { "type": "string", "minLength": 1 } },
          "notes": { "type": ["string", "null"] }
        },
        "allOf": [
          {
            "if": { "required": ["production"], "properties": { "production": { "const": true } } },
            "then": { "properties": { "team": { "enum": ["read", "none"] } } }
          },
          {
            "if": { "required": ["workspace"], "properties": { "workspace": { "const": "production" } } },
            "then": { "properties": { "team": { "enum": ["read", "none"] } } }
          }
        ]
      }
    },
    "data_rules": {
      "description": "Rules on existing data and objects given by the PO, e.g. which tables may never be dropped and the exceptions",
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "naming": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "resource_prefix": { "type": ["string", "null"] },
        "table_case": { "enum": ["snake_case", "camelCase", "PascalCase", "UPPER_CASE"] }
      }
    },
    "tags": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    },
    "code": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "style": { "enum": ["files", "notebooks"] }
      }
    },
    "custom": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    }
  },
  "if": { "properties": { "source": { "const": "derived" } }, "required": ["source"] },
  "then": { "required": ["source_reference"], "properties": { "source_reference": { "type": "string", "minLength": 1 } } }
}
