{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/alessandro9110/deltaforce-ai/blob/main/schemas/event.schema.json",
  "title": "DeltaForce lifecycle event",
  "description": "One line of .deltaforce/events.jsonl.",
  "type": "object",
  "additionalProperties": false,
  "required": ["ts", "role", "event", "data"],
  "properties": {
    "ts": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?(Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "role": {
      "enum": [
        "po",
        "pm",
        "solution-architect",
        "business-analyst",
        "data-engineer",
        "data-analyst",
        "data-scientist",
        "ai-engineer",
        "qa-engineer",
        "devops-engineer"
      ]
    },
    "event": {
      "enum": [
        "kickoff_completed",
        "phase_changed",
        "feature_created",
        "feature_status_changed",
        "task_status_changed",
        "delegation_started",
        "delegation_finished",
        "deploy_started",
        "deploy_finished",
        "test_run",
        "po_decision",
        "escalation",
        "conventions_changed"
      ]
    },
    "feature": { "type": "string", "pattern": "^F-[0-9]{3,}$" },
    "task": { "type": "string", "pattern": "^T-[0-9]{3,}\\.[0-9]+$" },
    "data": { "type": "object" }
  }
}
